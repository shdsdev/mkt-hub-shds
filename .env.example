# Database (Supabase local direct connection, not the pooler)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55422/postgres"

# Supabase local API
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:55421"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-local-anon-key"

# Server-only privileged key - NEVER prefix with NEXT_PUBLIC_, never ships to the client
SUPABASE_SERVICE_ROLE_KEY="your-local-service-role-key"

# Reserved, unused until Phase 7 (docs/SPEC.md section 21)
TRACKING_RETENTION_MONTHS="14"

# Reserved, unused until Phase 1
DEFAULT_ORGANIZATION_ID=""

# Reserved, unused until Phase 2 (docs/SPEC.md section 17)
GA4_MEASUREMENT_ID=""

# AI agent platform (docs/ai-platform) — required before any provider credential is stored/used.
# 32-byte AES-256-GCM key, base64-encoded (e.g. `openssl rand -base64 32`).
AI_CREDENTIALS_ENCRYPTION_KEY=""

# Optional provider preference order (comma-separated). Defaults to
# openrouter,anthropic,openai,gemini.
AI_PROVIDER_ORDER=""
KNOWLEDGE_MAX_UPLOAD_BYTES=26214400
KNOWLEDGE_MAX_EXTRACTED_BYTES=10485760
KNOWLEDGE_EXTRACTION_TIMEOUT_MS=60000
KNOWLEDGE_EXTRACTION_MEMORY_MB=512
KNOWLEDGE_WORKER_POLL_INTERVAL_MS=1000
EVENTS_REMINDER_JOB_SECRET=
RESEND_API_KEY=
RESEND_FROM=
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_APP_ORIGIN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
