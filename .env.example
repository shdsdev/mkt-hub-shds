# Database (Supabase local direct connection, not the pooler)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Supabase local API
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-local-anon-key"

# Server-only privileged key - NEVER prefix with NEXT_PUBLIC_, never ships to the client
SUPABASE_SERVICE_ROLE_KEY="your-local-service-role-key"

# Reserved, unused until Phase 7 (docs/SPEC.md section 21)
TRACKING_RETENTION_MONTHS="14"

# Reserved, unused until Phase 1
DEFAULT_ORGANIZATION_ID=""

# Reserved, unused until Phase 2 (docs/SPEC.md section 17)
GA4_MEASUREMENT_ID=""
